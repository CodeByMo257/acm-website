---
interface Props {
  src: string;
  alt: string;
  screenBg?: string;
  padding?: string;
  fit?: "contain" | "cover";
}
const { src, alt, screenBg = "#ffffff", padding = "18%", fit = "contain" } = Astro.props;
---

<div class="phone-mockup">
  <div class="phone-frame">
    <div class="phone-screen" style={`background:${screenBg};`}>
      <img src={src} alt={alt} style={`padding:${fit === "cover" ? "0" : padding};object-fit:${fit};`} />
      <div class="phone-sheen"></div>
    </div>
    <div class="phone-island"></div>
    <span class="phone-btn vol-up"></span>
    <span class="phone-btn vol-down"></span>
    <span class="phone-btn power"></span>
  </div>
</div>

<style>
  .phone-mockup {
    display: flex;
    justify-content: center;
    padding: 2.5rem 1rem;
    perspective: 1400px;
  }

  .phone-frame {
    position: relative;
    width: 200px;
    aspect-ratio: 9 / 19.3;
    border-radius: 2.6rem;
    padding: 9px;
    background: linear-gradient(150deg, #4b4f56 0%, #232529 22%, #121316 55%, #030303 100%);
    box-shadow:
      0 45px 70px -25px rgba(17, 30, 46, 0.5),
      0 15px 30px -12px rgba(17, 30, 46, 0.4),
      inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    transform: rotateY(-10deg) rotateX(3deg);
    transform-style: preserve-3d;
    transition: transform 0.5s ease;
  }

  .phone-frame:hover {
    transform: rotateY(-4deg) rotateX(1deg);
  }

  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 2.1rem;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.5);
  }

  .phone-screen img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .phone-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0) 28%);
    pointer-events: none;
  }

  .phone-island {
    position: absolute;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    width: 34%;
    height: 16px;
    background: #05060a;
    border-radius: 999px;
    z-index: 5;
  }

  .phone-btn {
    position: absolute;
    background: linear-gradient(150deg, #4b4f56, #121316);
    border-radius: 3px;
  }
  .phone-btn.vol-up {
    left: -3px;
    top: 22%;
    width: 3px;
    height: 7%;
  }
  .phone-btn.vol-down {
    left: -3px;
    top: 32%;
    width: 3px;
    height: 7%;
  }
  .phone-btn.power {
    right: -3px;
    top: 26%;
    width: 3px;
    height: 11%;
  }
</style>
