---
interface Props {
  heading: string;
  body: string;
}
const { heading, body } = Astro.props;
---

<section class="bg-navy relative overflow-hidden">
  <img src="/images/logo/fleur-de-lis.png" alt="" class="pointer-events-none select-none absolute -right-16 -bottom-16 w-72 opacity-[0.06]" />
  <div class="relative mx-auto max-w-3xl px-6 py-20 text-center">
    <h2 class="font-display text-cream text-3xl sm:text-4xl mb-4">{heading}</h2>
    <p class="text-cream/70 text-[15px] mb-8 max-w-xl mx-auto leading-relaxed">{body}</p>
    <a href="/contact" class="caps inline-block text-[13px] tracking-[0.12em] bg-gold text-navy px-8 py-4 rounded-sm hover:bg-gold-bright transition-colors">
      Let&rsquo;s Talk About Your Business
    </a>
  </div>
</section>
