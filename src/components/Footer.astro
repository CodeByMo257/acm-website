---
const year = 2026;
---
<footer class="bg-navy-deep text-cream/70 border-t border-white/10">
  <div class="mx-auto max-w-6xl px-6 py-14 grid gap-10 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-3 mb-3">
        <img src="/images/logo/fleur-de-lis.png" alt="" class="h-7 w-auto" />
        <span class="font-display text-lg text-cream">Acadiana Creative Marketing</span>
      </div>
      <p class="text-sm max-w-xs">Helping local businesses stand out — branding, content, websites, social, and SEO, built by small business owners.</p>
    </div>

    <div>
      <div class="caps text-[11px] text-gold mb-4">Site</div>
      <ul class="space-y-2 text-sm">
        <li><a href="/services" class="hover:text-gold">Services</a></li>
        <li><a href="/about" class="hover:text-gold">About</a></li>
        <li><a href="/our-work" class="hover:text-gold">Our Work</a></li>
        <li><a href="/contact" class="hover:text-gold">Contact</a></li>
      </ul>
    </div>

    <div>
      <div class="caps text-[11px] text-gold mb-4">Get in touch</div>
      <ul class="space-y-2 text-sm">
        <li><a href="mailto:info@acadianacreative.org" class="hover:text-gold">info@acadianacreative.org</a></li>
        <li><a href="https://www.facebook.com/profile.php?id=61589385400418" target="_blank" rel="noopener" class="hover:text-gold">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto max-w-6xl px-6 py-5 text-xs text-cream/50 flex justify-center sm:justify-start">
      <span>&copy; {year} Acadiana Creative Marketing. All rights reserved.</span>
    </div>
  </div>
</footer>
