---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Not sure what your business needs? Start there. Reach Acadiana Creative Marketing by email or Facebook."
>
  <section class="bg-navy relative overflow-hidden">
    <img src="/images/logo/fleur-de-lis.png" alt="" class="pointer-events-none select-none absolute -left-24 -bottom-24 w-96 opacity-[0.06]" />
    <div class="relative mx-auto max-w-3xl px-6 pt-20 pb-16 text-center">
      <p class="caps text-gold text-xs tracking-[0.25em] mb-5">Contact</p>
      <h1 class="font-display text-cream text-4xl sm:text-5xl mb-6 leading-tight">
        Not Sure What Your Business Needs? Start There.
      </h1>
      <p class="text-cream/75 text-[16px] max-w-xl mx-auto leading-relaxed">
        You don&rsquo;t need to know whether you need SEO, a new website, a rebrand, or a social media package. Tell us what&rsquo;s working, what&rsquo;s frustrating you, and where you&rsquo;re trying to go. We&rsquo;ll help you figure out the next step.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-24">
    <div class="grid md:grid-cols-2 gap-10">
      <div class="bg-white border border-navy/10 rounded-sm p-9">
        <h2 class="font-display text-navy text-xl mb-4">Start the conversation</h2>
        <p class="text-ink-soft text-[15px] leading-relaxed mb-6">
          Every project is custom-quoted, so the best first step is simply telling us about your business. Email us directly and include:
        </p>
        <ul class="space-y-3 mb-8">
          <li class="flex gap-3">
            <span class="text-gold font-display text-lg leading-none">&mdash;</span>
            <span class="text-[15px] text-ink-soft">What can we help you with?</span>
          </li>
          <li class="flex gap-3">
            <span class="text-gold font-display text-lg leading-none">&mdash;</span>
            <span class="text-[15px] text-ink-soft">What feels like the biggest challenge with your digital presence right now?</span>
          </li>
        </ul>
        <a
          href="mailto:info@acadianacreative.org?subject=Let%27s%20talk%20about%20my%20business"
          class="caps inline-block text-[13px] tracking-[0.12em] bg-gold text-navy px-7 py-3.5 rounded-sm hover:bg-gold-bright transition-colors"
        >
          Email Us
        </a>
      </div>

      <div class="bg-navy rounded-sm p-9 flex flex-col justify-between relative overflow-hidden">
        <img src="/images/logo/fleur-de-lis.png" alt="" class="pointer-events-none select-none absolute -right-8 -bottom-8 w-32 opacity-[0.08]" />
        <div class="relative">
          <h2 class="font-display text-cream text-xl mb-4">Find us</h2>
          <div class="space-y-4">
            <div>
              <div class="caps text-[11px] text-gold tracking-[0.15em] mb-1">Email</div>
              <a href="mailto:info@acadianacreative.org" class="text-cream/85 hover:text-gold text-[15px]">info@acadianacreative.org</a>
            </div>
            <div>
              <div class="caps text-[11px] text-gold tracking-[0.15em] mb-1">Facebook</div>
              <a href="https://www.facebook.com/profile.php?id=61589385400418" target="_blank" rel="noopener" class="text-cream/85 hover:text-gold text-[15px]">Acadiana Creative Marketing</a>
            </div>
            <div>
              <div class="caps text-[11px] text-gold tracking-[0.15em] mb-1">Serving</div>
              <span class="text-cream/85 text-[15px]">Acadiana, Louisiana</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
